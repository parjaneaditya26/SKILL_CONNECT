; Copy this file to ".env" and fill in your REAL values. Never commit ".env".
; Wrap a value in double quotes if it contains special characters like ! $ ; = or spaces.

GEMINI_API_KEY="your_new_gemini_key"
ADMIN_USER=admin
ADMIN_PASS="choose_a_long_new_password"

DB_HOST=localhost
DB_USER=your_db_user
DB_PASS="your_db_password"
DB_NAME=your_db_name

; Full address of your site, no trailing slash. Used for links inside emails.
APP_URL=https://yourdomain.com
